#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot hook — install as ~/.termux/boot/01-start-agent
# Starts dispatcher-go after device boot; crash-resume runs inside the daemon.
set -eu
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
DISPATCHER_HOME="${DISPATCHER_HOME:-$HOME/dispatcher-go}"
BIN="${DISPATCHER_BIN:-$PREFIX/bin/dispatcher-go}"
# Daemon inherits this shell's PATH for termux-* lookup — make it explicit:
# boot/adb environments often carry a minimal PATH without the Termux bin dir.
export PATH="$PREFIX/bin:/system/bin:/system/xbin${PATH:+:$PATH}"
# Opt-in full autonomy (remote agents): drop a policy file and/or marker
# into $DISPATCHER_HOME and the flags follow automatically. Absent both,
# the daemon starts attended (human-gated) as before.
EXTRA=""
if [ -f "${DISPATCHER_HOME}/.agent/approval-policy.json" ]; then
  EXTRA="$EXTRA -policy-file ${DISPATCHER_HOME}/.agent/approval-policy.json"
fi
if [ -f "${DISPATCHER_HOME}/.unattended" ]; then
  EXTRA="$EXTRA -unattended"
fi
LOGDIR="${DISPATCHER_HOME}/logs"
mkdir -p "$LOGDIR" "$DISPATCHER_HOME/data"
# avoid duplicate if already running
if pgrep -f 'dispatcher-go' >/dev/null 2>&1; then
  exit 0
fi
# shellcheck disable=SC2086
nohup "$BIN" \
  -data-dir "$DISPATCHER_HOME" \
  -catalog "${DISPATCHER_HOME}/verbs.yaml" \
  $EXTRA \
  >>"$LOGDIR/daemon.stdout" 2>>"$LOGDIR/daemon.stderr" &
